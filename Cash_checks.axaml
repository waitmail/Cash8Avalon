<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="600"            
             x:Class="Cash8Avalon.Cash_checks">
    
    <Grid Margin="10" Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Верхняя панель (убран Grid с колонками, оставлен только StackPanel) -->
        <StackPanel Grid.Row="0" Spacing="10">
            <!-- Строка 1: Документы и кнопки -->
            <DockPanel Name="Row1Panel">
                <TextBox Name="txtB_not_unloaded_docs" 
                        IsEnabled="False"
                        Text=""
                        FontSize="12"
                        Margin="0,0,10,0"
                        MinHeight="30"
                        MinWidth="500"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="Black"/>
                
                <Button Name="btn_update_status_send" 
                       Content="Обновить" 
                       Width="90"
                       Height="30"
                       Margin="0,0,10,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="White"
                       Background="#FF2196F3"
                       BorderBrush="#1976D2"
                       BorderThickness="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       CornerRadius="3"
                       Cursor="Hand">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#FF42A5F5"/>
                            <Setter Property="BorderBrush" Value="#1E88E5"/>
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="BorderBrush" Value="#1565C0"/>
                        </Style>
                    </Button.Styles>
                </Button>
                
                <Button Name="btn_check_actions" 
                       Content="ПРОВЕРКА АКЦИЙ" 
                       Width="170"
                       Height="30"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="White"
                       Background="#FF2196F3"
                       BorderBrush="#1976D2"
                       BorderThickness="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       CornerRadius="3"
                       Cursor="Hand">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#FF42A5F5"/>
                            <Setter Property="BorderBrush" Value="#1E88E5"/>
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="BorderBrush" Value="#1565C0"/>
                        </Style>
                    </Button.Styles>
                </Button>                
            </DockPanel>
            
            <!-- Строка 2: Фильтры -->
            <DockPanel Name="Row2Panel">
                <!-- Левая часть: Дата -->
                <StackPanel Orientation="Horizontal" Spacing="5" Name="DatePanel">
                    <TextBlock Text="На дату:" 
                              VerticalAlignment="Center"/>
                    
                    <!-- Простой TextBox для отображения даты -->
                    <TextBox Name="txtSelectedDate"
                           Width="100"
                           Height="30"
                           VerticalAlignment="Center"
                           Text=""
                           IsReadOnly="True"
                           Background="White"
                           Foreground="Black"/>
                    
                    <!-- Простая кнопка для выбора даты -->
                    <Button Name="btnSelectDate"
                           Content="📅"
                           Width="30"
                           Height="30"
                           VerticalAlignment="Center"
                           Background="White"
                           BorderBrush="Gray"
                           BorderThickness="1"
                           Click="BtnSelectDate_Click">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <Button Name="fill" 
                           Content="Заполнить" 
                           Width="100"
                           Height="30"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Background="#FF2196F3"
                           BorderBrush="#1976D2"
                           BorderThickness="2"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           CornerRadius="3"
                           Cursor="Hand"
                           Click="Fill_Click">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#FF42A5F5"/>
                                <Setter Property="BorderBrush" Value="#1E88E5"/>
                            </Style>
                            <Style Selector="Button:pressed">
                                <Setter Property="Background" Value="#1976D2"/>
                                <Setter Property="BorderBrush" Value="#1565C0"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
                
                <!-- Центр: Кассир и номер кассы -->
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="20,0,0,0" Name="CashierPanel">
                    <TextBlock Text="Кассир:" 
                              VerticalAlignment="Center"/>
                    <TextBox Name="txtB_cashier" 
                            IsEnabled="False"
                            Width="150"
                            Height="30"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Background="White"
                            Foreground="Black"/>
                    
                    <Border BorderBrush="Gray" 
                           BorderThickness="1" 
                           Padding="5"
                           CornerRadius="3"
                           Background="White"
                           MinWidth="150">
                        <TextBlock Name="num_cash" 
                                  Text="" 
                                  Foreground="Maroon"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                    </Border>
                    
                    <CheckBox Name="checkBox_show_3_last_checks" 
                             Content="3"
                             IsChecked="True"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
        
        <!-- ОБЛАСТЬ ДЛЯ ТАБЛИЦЫ -->
        <Border Grid.Row="1" 
                BorderBrush="BlueViolet" 
                BorderThickness="2"
                Margin="0,10,0,10"
                Background="White"
                Name="TableBorder">
            <!-- DataGrid будет добавлен в коде -->
        </Border>
        
        <!-- Нижняя панель с подсказками, комментарием и кнопкой -->
        <Grid Grid.Row="2" Margin="0,10,0,0" Name="BottomPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Левая часть: горячие клавиши -->
                <ColumnDefinition Width="*"/>    <!-- Средняя часть: TextBox (занимает всё свободное место) -->
                <ColumnDefinition Width="Auto"/> <!-- Правая часть: кнопка Закрыть -->
            </Grid.ColumnDefinitions>
    
            <!-- Левая часть: Текст с горячими клавишами -->
            <TextBlock Grid.Column="0" 
                       VerticalAlignment="Center"
                       Foreground="#555555"
                       FontSize="12"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Margin="0,0,20,0">
                <Run FontWeight="SemiBold" Text="Insert"/>
                <Run Text=" — создание нового чека"/>
                <LineBreak/>
                <Run FontWeight="SemiBold" Text="Enter"/>
                <Run Text=" — открытие старого чека (просмотр)"/>
            </TextBlock>
    
            <!-- Средняя часть: TextBox для комментария -->
            <TextBox Grid.Column="1"
                     Name="txtB_selected_comment"
                     IsReadOnly="True"
                     MinHeight="30"
                     VerticalAlignment="Center"
                     Margin="0,0,20,0"
                     Background="White"
                     Foreground="Black"
                     FontSize="14"
                     Watermark="Комментарий выделенного чека..."
                     TextWrapping="Wrap" />
    
            <!-- Правая часть: Кнопка закрытия -->
            <Button Grid.Column="2" 
                    Name="button1" 
                    Content="Закрыть" 
                    Width="120"
                    Height="40"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Background="#FF2196F3"
                    BorderBrush="#1976D2"
                    BorderThickness="2"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    CornerRadius="5"
                    Cursor="Hand"
                    Click="Button1_Click">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="#FF42A5F5"/>
                        <Setter Property="BorderBrush" Value="#1E88E5"/>
                    </Style>
                    <Style Selector="Button:pressed">
                        <Setter Property="Background" Value="#1976D2"/>
                        <Setter Property="BorderBrush" Value="#1565C0"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>
    </Grid>
</UserControl>